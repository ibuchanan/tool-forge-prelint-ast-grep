{
  "name": "tool-forge-prelint-ast-grep",
  "version": "0.6.0",
  "private": true,
  "description": "ast-grep lint rules for Atlassian Forge apps",
  "homepage": "https://github.com/ibuchanan/tool-forge-prelint-ast-grep#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibuchanan/tool-forge-prelint-ast-grep.git"
  },
  "license": "Apache-2.0",
  "files": [
    "rules/",
    "sgconfig.recommended.yml",
    "sgconfig.strict.yml",
    "sgconfig.atlassian.yml",
    "sgconfig.ecosol.yml"
  ],
  "scripts": {
    "changelog": "touch CHANGELOG.md && git cliff --offline --unreleased --prepend CHANGELOG.md",
    "check": "lefthook run pre-push --force",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "lefthook install || true",
    "release:prepare": "scripts/release-prepare.sh",
    "test": "ast-grep test --test-dir rule-tests && npm run test:fixtures",
    "test:fixtures": "scripts/check-fixtures.sh",
    "test:interactive": "ast-grep test --test-dir rule-tests --interactive",
    "test:update": "ast-grep test --test-dir rule-tests --update-all",
    "todo": "grep -rn 'TODO' --exclude='package.json' . --color=auto || echo 'No TODOs found!'"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.44",
    "lefthook": "^2.1",
    "prettier": "^3.9"
  }
}
