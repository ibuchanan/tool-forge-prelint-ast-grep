{
  "name": "example-forge-app",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "changelog": "git cliff --offline --unreleased --prepend CHANGELOG.md",
    "check": "run-p --npm-path npm --print-label format:check typecheck lint test size:check",
    "dev": "tsc -p tsconfig.build.json --watch",
    "forge:deploy": "cmd=$(fence-rider deploy -- --non-interactive) && sh -c \"$cmd\" sh",
    "forge:install": "cmd=$(fence-rider install -- --non-interactive) && sh -c \"$cmd\" sh",
    "forge:register": "forge register",
    "forge:uninstall": "cmd=$(fence-rider uninstall) && sh -c \"$cmd\" sh",
    "forge:upgrade": "cmd=$(fence-rider install -- --upgrade --non-interactive) && sh -c \"$cmd\" sh",
    "forge:variables:set": "fence-rider variables",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "run-p --npm-path npm --print-label lint:prelint lint:check lint:forge",
    "lint:check": "biome lint .",
    "lint:fix": "biome lint --write .",
    "lint:forge": "cmd=$(fence-rider lint) && sh -c \"$cmd\" sh",
    "lint:prelint": "ast-grep scan --config node_modules/tool-forge-prelint-ast-grep/sgconfig.strict.yml --globs '!node_modules/**'",
    "prepare": "lefthook install",
    "size:check": "npm run build && size-limit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@forge-ahead/atlassian-api-types": "github:ibuchanan/forge-ahead-atlassian-api-types#0.1.0",
    "@forge-ahead/errors": "github:ibuchanan/forge-ahead-errors#0.1.0",
    "@forge-ahead/logging": "github:ibuchanan/forge-ahead-logging#0.1.0",
    "@forge/api": "^8.0",
    "@forge/events": "^3.0.1",
    "@forge/kvs": "^2.0.1",
    "@forge/react": "^12.0",
    "react": "^18.2",
    "zod": "^4.4"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.44",
    "@biomejs/biome": "2.5.2",
    "@size-limit/file": "^12.1",
    "@types/node": "24",
    "lefthook": "^2.1",
    "npm-run-all2": "^9.0.4",
    "size-limit": "^12.1",
    "tool-forge-prelint-ast-grep": "github:ibuchanan/tool-forge-prelint-ast-grep#v0.2.0",
    "typescript": "^5.9",
    "vitest": "^4.1"
  },
  "size-limit": [
    {
      "name": "Forge backend action bundle",
      "path": [
        "dist/**/*.js",
        "!dist/frontend/**"
      ],
      "limit": "15 kB"
    }
  ]
}
